# Canlı site adresi (Google sitemap ve robots için)
NEXT_PUBLIC_SITE_URL=https://retim.com.tr

# Web3Forms — tarayıcıdan form gönderimi için (web3forms.com'dan alın)
# NOT: Ücretsiz planda sunucu tarafı gönderim çalışmaz; bu public key kullanılmalıdır.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Form maillerinin düşeceği adres (Web3Forms hesabında doğrulanmış olmalı)
CONTACT_EMAIL=retim@retim.com.tr

# İsteğe bağlı — Web3Forms yerine Resend kullanmak için:
# RESEND_API_KEY=
# CONTACT_FROM=Retim İletişim <iletisim@retim.com.tr>

# --- Admin Panel (Supabase) ---
# supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin giriş şifresi (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
