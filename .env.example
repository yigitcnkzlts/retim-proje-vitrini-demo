# Canlı site adresi (Google sitemap ve robots için)
NEXT_PUBLIC_SITE_URL=https://retim.com.tr

# Web3Forms — web3forms.com'dan alın (retim@retim.com.tr doğrulanmış olmalı)
WEB3FORMS_ACCESS_KEY=

# İsteğe bağlı — build-time fallback (WEB3FORMS_ACCESS_KEY tercih edilir)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Form maillerinin düşeceği adres (Web3Forms hesabında doğrulanmış olmalı)
CONTACT_EMAIL=retim@retim.com.tr

# İsteğe bağlı — Web3Forms yerine Resend kullanmak için:
# RESEND_API_KEY=
# CONTACT_FROM=Retim İletişim <iletisim@retim.com.tr>

# --- Admin Panel (Supabase) ---
# supabase.com → Project Settings → API (veya Data API sekmesi)
#
# NEXT_PUBLIC_SUPABASE_URL: sadece proje ana adresi, SONUNDA /rest/v1/ OLMADAN.
#   Doğru:  https://xxxxxxxxxxxx.supabase.co
#   Yanlış: https://xxxxxxxxxxxx.supabase.co/rest/v1/
# NEXT_PUBLIC_SUPABASE_ANON_KEY: "anon" / "publishable" key — public, client'ta kullanılabilir
# SUPABASE_SERVICE_ROLE_KEY: "service_role" / "secret" key — GİZLİ, SADECE server'da kullanılır,
#   asla NEXT_PUBLIC_ önekiyle veya client koduna koymayın
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin giriş şifresi (/admin) — ikisinden biri yeterli
# Önerilen: bcrypt hash (npm run hash-password ile üretin)
ADMIN_PASSWORD_HASH=
# Alternatif (geliştirme ortamı) — düz metin şifre, production'da ÖNERİLMEZ
ADMIN_PASSWORD=
# Oturum imzalama anahtarı — rastgele, uzun bir metin
ADMIN_SESSION_SECRET=
